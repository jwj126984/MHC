<Window x:Class="MHC.CANConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="CAN配置"
        Height="420"
        Width="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#f0f0f0">
        <!-- 标题栏 -->
        <StackPanel Background="#0066cc" Height="60" VerticalAlignment="Top">
            <TextBlock Text="CAN设备配置" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,0"/>
        </StackPanel>
        
        <!-- 配置表单 -->
        <Grid Margin="40,80,40,40">
            <!-- 设备类型 -->
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="80"/>
            </Grid.RowDefinitions>
            
            <!-- 设备类型 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="设备类型:" FontSize="16" Width="100" VerticalAlignment="Center"/>
                <ComboBox x:Name="DeviceTypeComboBox" Width="300" Height="30" FontSize="14"/>
            </StackPanel>
            
            <!-- 设备索引号 -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="设备索引号:" FontSize="16" Width="100" VerticalAlignment="Center"/>
                <ComboBox x:Name="DeviceIndexComboBox" Width="300" Height="30" FontSize="14"/>
            </StackPanel>
            
            <!-- 通道号 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="通道号:" FontSize="16" Width="100" VerticalAlignment="Center"/>
                <ComboBox x:Name="ChannelIndexComboBox" Width="300" Height="30" FontSize="14"/>
            </StackPanel>
            
            <!-- 波特率 -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="波特率:" FontSize="16" Width="100" VerticalAlignment="Center"/>
                <ComboBox x:Name="BaudRateComboBox" Width="300" Height="30" FontSize="14"/>
            </StackPanel>
            
            <!-- 按钮 -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Margin" Value="0,0,20,0"/>
                    </Style>
                </StackPanel.Resources>
                <Button x:Name="ConnectButton" Content="连接" Width="120" Height="40" FontSize="16" Background="#0066cc" Foreground="White" FontWeight="Bold"/>
                <Button x:Name="CancelButton" Content="取消" Width="120" Height="40" FontSize="16" Background="#999999" Foreground="White" FontWeight="Bold"/>
            </StackPanel>
        </Grid>
        
        <!-- 状态信息 -->
        <TextBlock x:Name="StatusTextBlock" Text="" FontSize="14" Foreground="Red" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20"/>
    </Grid>
</Window>