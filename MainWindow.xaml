                                        <Ellipse Width="8" Height="8" Fill="{Binding SignalValues[SuperCapController_Motor2OpenCircuit], Converter={StaticResource BoolToBrushConverter}}" Margin="0,0,3,0" x:Name="Motor2OpenCircuitEllipse"/>
                                        <TextBlock Text="{Binding SignalValues[SuperCapController_Motor2OpenCircuit], Converter={StaticResource BoolToStringConverter}}" x:Name="Motor2OpenCircuitStatus" Foreground="{Binding SignalValues[SuperCapController_Motor2OpenCircuit], Converter={StaticResource BoolToBrushConverter}}" FontSize="10"/>
                                    </StackPanel>

                                    <!-- 电机3 -->
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="LR后门电机:"/>
                                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{Binding SignalValues[SuperCapController_Motor3ShortPower], Converter={StaticResource BoolToBrushConverter}}" Margin="0,0,3,0" x:Name="Motor3ShortPowerEllipse"/>
                                        <TextBlock Text="{Binding SignalValues[SuperCapController_Motor3ShortPower], Converter={StaticResource BoolToStringConverter}}" x:Name="Motor3ShortPowerStatus" Foreground="{Binding SignalValues[SuperCapController_Motor3ShortPower], Converter={StaticResource BoolToBrushConverter}}" FontSize="10"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="3" Grid.Column="2" Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{Binding SignalValues[SuperCapController_Motor3ShortGround], Converter={StaticResource BoolToBrushConverter}}" Margin="0,0,3,0" x:Name="Motor3ShortGroundEllipse"/>
                                        <TextBlock Text="{Binding SignalValues[SuperCapController_Motor3ShortGround], Converter={StaticResource BoolToStringConverter}}" x:Name="Motor3ShortGroundStatus" Foreground="{Binding SignalValues[SuperCapController_Motor3ShortGround], Converter={StaticResource BoolToBrushConverter}}" FontSize="10"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="3" Grid.Column="3" Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{Binding SignalValues[SuperCapController_Motor3OpenCircuit], Converter={StaticResource BoolToBrushConverter}}" Margin="0,0,3,0" x:Name="Motor3OpenCircuitEllipse"/>
                                        <TextBlock Text="{Binding SignalValues[SuperCapController_Motor3OpenCircuit], Converter={StaticResource BoolToStringConverter}}" x:Name="Motor3OpenCircuitStatus" Foreground="{Binding SignalValues[SuperCapController_Motor3OpenCircuit], Converter={StaticResource BoolToBrushConverter}}" FontSize="10"/>
                                    </StackPanel>

                                    <!-- 电机4 -->
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="RR后门电机:"/>
                                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{Binding SignalValues[SuperCapController_Motor4ShortPower], Converter={StaticResource BoolToBrushConverter}}" Margin="0,0,3,0" x:Name="Motor4ShortPowerEllipse"/>
                                        <TextBlock Text="{Binding SignalValues[SuperCapController_Motor4ShortPower], Converter={StaticResource BoolToStringConverter}}" x:Name="Motor4ShortPowerStatus" Foreground="{Binding SignalValues[SuperCapController_Motor4ShortPower], Converter={StaticResource BoolToBrushConverter}}" FontSize="10"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="4" Grid.Column="2" Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{Binding SignalValues[SuperCapController_Motor4ShortGround], Converter={StaticResource BoolToBrushConverter}}" Margin="0,0,3,0" x:Name="Motor4ShortGroundEllipse"/>
                                        <TextBlock Text="{Binding SignalValues[SuperCapController_Motor4ShortGround], Converter={StaticResource BoolToStringConverter}}" x:Name="Motor4ShortGroundStatus" Foreground="{Binding SignalValues[SuperCapController_Motor4ShortGround], Converter={StaticResource BoolToBrushConverter}}" FontSize="10"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="4" Grid.Column="3" Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{Binding SignalValues[SuperCapController_Motor4OpenCircuit], Converter={StaticResource BoolToBrushConverter}}" Margin="0,0,3,0" x:Name="Motor4OpenCircuitEllipse"/>
                                        <TextBlock Text="{Binding SignalValues[SuperCapController_Motor4OpenCircuit], Converter={StaticResource BoolToStringConverter}}" x:Name="Motor4OpenCircuitStatus" Foreground="{Binding SignalValues[SuperCapController_Motor4OpenCircuit], Converter={StaticResource BoolToBrushConverter}}" FontSize="10"/>
                                    </StackPanel>

                                    <!-- 电机5 -->
                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="LR儿童锁电机:"/>
                                    <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{Binding SignalValues[SuperCapController_Motor5ShortPower], Converter={StaticResource BoolToBrushConverter}}" Margin="0,0,3,0" x:Name="Motor5ShortPowerEllipse"/>
                                        <TextBlock Text="{Binding SignalValues[SuperCapController_Motor5ShortPower], Converter={StaticResource BoolToStringConverter}}" x:Name="Motor5ShortPowerStatus" Foreground="{Binding SignalValues[SuperCapController_Motor5ShortPower], Converter={StaticResource BoolToBrushConverter}}" FontSize="10"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="5" Grid.Column="2" Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{Binding SignalValues[SuperCapController_Motor5ShortGround], Converter={StaticResource BoolToBrushConverter}}" Margin="0,0,3,0" x:Name="Motor5ShortGroundEllipse"/>
                                        <TextBlock Text="{Binding SignalValues[SuperCapController_Motor5ShortGround], Converter={StaticResource BoolToStringConverter}}" x:Name="Motor5ShortGroundStatus" Foreground="{Binding SignalValues[SuperCapController_Motor5ShortGround], Converter={StaticResource BoolToBrushConverter}}" FontSize="10"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="5" Grid.Column="3" Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{Binding SignalValues[SuperCapController_Motor5OpenCircuit], Converter={StaticResource BoolToBrushConverter}}" Margin="0,0,3,0" x:Name="Motor5OpenCircuitEllipse"/>
                                        <TextBlock Text="{Binding SignalValues[SuperCapController_Motor5OpenCircuit], Converter={StaticResource BoolToStringConverter}}" x:Name="Motor5OpenCircuitStatus" Foreground="{Binding SignalValues[SuperCapController_Motor5OpenCircuit], Converter={StaticResource BoolToBrushConverter}}" FontSize="10"/>
                                    </StackPanel>

                                    <!-- 电机6 -->
                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="RR儿童锁电机:"/>
                                    <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{Binding SignalValues[SuperCapController_Motor6ShortPower], Converter={StaticResource BoolToBrushConverter}}" Margin="0,0,3,0" x:Name="Motor6ShortPowerEllipse"/>
                                        <TextBlock Text="{Binding SignalValues[SuperCapController_Motor6ShortPower], Converter={StaticResource BoolToStringConverter}}" x:Name="Motor6ShortPowerStatus" Foreground="{Binding SignalValues[SuperCapController_Motor6ShortPower], Converter={StaticResource BoolToBrushConverter}}" FontSize="10"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="6" Grid.Column="2" Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{Binding SignalValues[SuperCapController_Motor6ShortGround], Converter={StaticResource BoolToBrushConverter}}" Margin="0,0,3,0" x:Name="Motor6ShortGroundEllipse"/>
                                        <TextBlock Text="{Binding SignalValues[SuperCapController_Motor6ShortGround], Converter={StaticResource BoolToStringConverter}}" x:Name="Motor6ShortGroundStatus" Foreground="{Binding SignalValues[SuperCapController_Motor6ShortGround], Converter={StaticResource BoolToBrushConverter}}" FontSize="10"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="6" Grid.Column="3" Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{Binding SignalValues[SuperCapController_Motor6OpenCircuit], Converter={StaticResource BoolToBrushConverter}}" Margin="0,0,3,0" x:Name="Motor6OpenCircuitEllipse"/>
                                        <TextBlock Text="{Binding SignalValues[SuperCapController_Motor6OpenCircuit], Converter={StaticResource BoolToStringConverter}}" x:Name="Motor6OpenCircuitStatus" Foreground="{Binding SignalValues[SuperCapController_Motor6OpenCircuit], Converter={StaticResource BoolToBrushConverter}}" FontSize="10"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="内部监控" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Fill="{Binding SignalValues[SuperCapController_InternalStatus], Converter={StaticResource InternalStatusBrushConverter}}" Margin="0,0,3,0" x:Name="InternalStatusEllipse"/>
                                        <TextBlock Text="{Binding SignalValues[SuperCapController_InternalStatus], Converter={StaticResource InternalStatusConverter}}" x:Name="InternalStatusText" Foreground="{Binding SignalValues[SuperCapController_InternalStatus], Converter={StaticResource InternalStatusBrushConverter}}" FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 第四行：CAN帧计数 -->
                    <Grid Grid.Row="4" Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="10" Grid.Column="0">
                            <StackPanel>
                                <TextBlock Text="发送帧" FontSize="12"/>
                                <TextBlock x:Name="SentFrameCountText" Text="0" FontSize="16" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="10" Grid.Column="1" Margin="10,0,10,0">
                            <StackPanel>
                                <TextBlock Text="接收帧" FontSize="12"/>
                                <TextBlock x:Name="ReceivedFrameCountText" Text="0" FontSize="16" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="10" Grid.Column="2">
                            <StackPanel>
                                <TextBlock Text="错误帧" FontSize="12"/>
                                <TextBlock x:Name="ErrorFrameCountText" Text="0" FontSize="16" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="控制区">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="控制区" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                    <!-- 功能控制 -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 点控功能 -->
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="点控功能" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="130"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="50"/>
                                            <RowDefinition Height="50"/>
                                            <RowDefinition Height="50"/>
                                        </Grid.RowDefinitions>

                                        <Button Grid.Row="0" Grid.Column="0" Content="左前门锁解锁" x:Name="FrontLeftLockUnlockButton" Margin="0,0,10,5" Width="120" Height="40" HorizontalAlignment="Right"/>
                                        <Button Grid.Row="0" Grid.Column="1" Content="右前门锁解锁" x:Name="FrontRightLockUnlockButton" Margin="0,0,0,5" Width="120" Height="40" HorizontalAlignment="Left"/>

                                        <Button Grid.Row="1" Grid.Column="0" Content="左后门锁解锁" x:Name="RearLeftLockUnlockButton" Margin="0,5,10,5" Width="120" Height="40" HorizontalAlignment="Right"/>
                                        <Button Grid.Row="1" Grid.Column="1" Content="右后门锁解锁" x:Name="RearRightLockUnlockButton" Margin="0,5,0,5" Width="120" Height="40" HorizontalAlignment="Left"/>

                                        <Button Grid.Row="2" Grid.Column="0" Content="左后门儿童锁" x:Name="RearLeftChildLockButton" Margin="0,5,10,0" Width="120" Height="40" HorizontalAlignment="Right"/>
                                        <Button Grid.Row="2" Grid.Column="1" Content="右后门儿童锁" x:Name="RearRightChildLockButton" Margin="0,5,0,0" Width="120" Height="40" HorizontalAlignment="Left"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 充放电控制 -->
                        <StackPanel Grid.Column="1">
                            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="充放电控制" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="130"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="45"/>
                                            <RowDefinition Height="45"/>
                                        </Grid.RowDefinitions>

                                        <Button Grid.Row="0" Grid.Column="0" Content="充电" x:Name="ChargeButton" Margin="0,0,5,0" Width="120" Height="40" HorizontalAlignment="Right"/>
                                        <Button Grid.Row="0" Grid.Column="1" Content="放电" x:Name="DischargeButton" Margin="0,0,0,0" Width="120" Height="40" HorizontalAlignment="Left"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- 自动化控制和参数设置 -->
                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 自动化控制 -->
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="5">
                                <StackPanel>
                                    <TextBlock Text="自动化控制" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="40"/>
                                            <RowDefinition Height="40"/>
                                            <RowDefinition Height="40"/>
                                            <RowDefinition Height="40"/>
                                        </Grid.RowDefinitions>

                                        <Button Grid.Row="0" Grid.Column="0" Content="DV环境工况" x:Name="DVTestButton" Margin="0,0,5,0" Width="140" Height="35" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="停止" x:Name="DVTestStatus" Margin="0,8,0,0" HorizontalAlignment="Left"/>

                                        <Button Grid.Row="1" Grid.Column="0" Content="DV热测试工况" x:Name="HeatTestButton" Margin="0,0,5,0" Width="140" Height="35" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="停止" x:Name="HeatTestStatus" Margin="0,8,0,0" HorizontalAlignment="Left"/>

                                        <Button Grid.Row="2" Grid.Column="0" Content="EMC试验工况" x:Name="EMCTestButton" Margin="0,0,5,0" Width="140" Height="35" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="停止" x:Name="EMCTestStatus"  Margin="0,8,0,0" HorizontalAlignment="Left"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 参数设置 -->
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="5">
                                <StackPanel>
                                    <TextBlock Text="参数设置" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="70"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="25"/>
                                            <RowDefinition Height="25"/>
                                            <RowDefinition Height="25"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="已循环次数:" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Text="0" x:Name="CurrentCycleCount" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="设置循环次数:" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="100" x:Name="TotalCycleCount" Margin="0,0,3,0" VerticalAlignment="Center" Width="50" HorizontalAlignment="Left"/>
                                        <Button Grid.Row="1" Grid.Column="2" Content="设置" x:Name="SetCycleCountButton" Width="60" Height="20" HorizontalAlignment="Left"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="循环间隔时间:" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBox Text="1000" x:Name="CycleIntervalTime" Margin="0,0,3,0" Width="50" HorizontalAlignment="Left"/>
                                            <TextBlock Text="ms" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Button Grid.Row="2" Grid.Column="2" Content="设置" x:Name="SetIntervalButton" Width="60" Height="20" HorizontalAlignment="Left"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- 休眠唤醒控制 -->
                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 休眠唤醒控制 -->
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="休眠唤醒控制" FontSize="14" FontWeight="Bold" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                                    <TextBlock Text="当前状态: 唤醒" x:Name="SleepWakeStatus" FontSize="20" FontWeight="Bold" Foreground="Green" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="35"/>
                                            <RowDefinition Height="35"/>
                                        </Grid.RowDefinitions>

                                        <Button Grid.Row="0" Grid.Column="0" Content="进入休眠" x:Name="EnterSleepButton" Margin="0,0,5,0" Width="90" Height="30" HorizontalAlignment="Right"/>
                                        <Button Grid.Row="0" Grid.Column="1" Content="退出休眠" x:Name="ExitSleepButton" Margin="0,0,0,0" Width="90" Height="30" HorizontalAlignment="Left"/>
                                        <Button Grid.Row="1" Grid.Column="0" Content="CAN唤醒" x:Name="CanWakeupButton" Margin="0,5,5,0" Width="90" Height="30" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 版本号读取 -->
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="版本号读取" FontSize="14" FontWeight="Bold" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                                    <Button Content="读取版本号" x:Name="ReadVersionButton" Margin="0,0,0,10" Width="150" Height="35" HorizontalAlignment="Center"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="25"/>
                                            <RowDefinition Height="25"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="软件版本:" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="V1.0.0" x:Name="SoftwareVersion" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="硬件版本:" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="V2.0.0" x:Name="HardwareVersion" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="故障监控">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="故障监控" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>



                    <!-- 故障码读取 -->
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <StackPanel>
                            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="故障码读取 (UDS协议)" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                                    <Button Content="读取故障码" x:Name="ReadFaultCodesButton" Margin="0,0,0,10" Width="120" Height="40"/>
                                    <ListBox x:Name="FaultCodesList" Height="150">
                                        <ListBoxItem>无故障码</ListBoxItem>
                                    </ListBox>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
