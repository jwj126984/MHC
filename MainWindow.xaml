<Window x:Class="MHC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MHC"
        mc:Ignorable="d"
        Title="碰撞电源模块监控系统V1.07" Height="768" Width="1024" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:BoolToBrushConverter x:Key="BoolToBrushConverter"/>
        <local:BoolToStringConverter x:Key="BoolToStringConverter"/>
        <local:StatusToStringConverter x:Key="StatusToStringConverter"/>
        <local:StatusToBrushConverter x:Key="StatusToBrushConverter"/>
        <local:CurrentToBrushConverter x:Key="CurrentToBrushConverter"/>
        <local:MochainStatusConverter x:Key="MochainStatusConverter"/>
        <local:MochainStatusBrushConverter x:Key="MochainStatusBrushConverter"/>
        <local:InternalStatusConverter x:Key="InternalStatusConverter"/>
        <local:InternalStatusBrushConverter x:Key="InternalStatusBrushConverter"/>
    </Window.Resources>
    <Grid>
        <TabControl x:Name="MainTabControl" Margin="10">
            <TabItem Header="监控区">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="监控区" FontSize="16" FontWeight="Bold"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button x:Name="SettingsButton" Content="参数设置" Width="70" Height="25" Margin="10,0,10,0" Click="SettingsButton_Click"/>
                            <Button x:Name="ClearFaultCountButton" Content="清零" Width="50" Height="25" Margin="0,0,10,0" Click="ClearFaultCount"/>
                            <TextBlock Text="故障次数:" Margin="0,0,5,0" />
                            <TextBlock Text="{Binding FaultCount}" FontSize="14" FontWeight="Bold" Foreground="Red" x:Name="FaultCountText"/>
                            
                        </StackPanel>
                    </Grid>

                    <!-- 第一行：电容监控和SRS碰撞CAN信号监控 -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 电容监控 -->
                        <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,0,5,0">
                            <StackPanel>
                                <TextBlock Text="电容监控" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>

                                <!-- 电容单体监控 -->
                                <TextBlock Text="电容单体监控" FontSize="12" FontWeight="Bold" Margin="0,0,0,3"/>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- 表头 -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="单体" FontWeight="Bold" Margin="0,0,5,2"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="电压(mV)" FontWeight="Bold" Margin="0,0,5,2"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="过压" FontWeight="Bold" Margin="0,0,5,2"/>
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="短路" FontWeight="Bold" Margin="0,0,5,2"/>
                                    <TextBlock Grid.Row="0" Grid.Column="4" Text="均衡" FontWeight="Bold" Margin="0,0,5,2"/>
                                    <TextBlock Grid.Row="0" Grid.Column="5" Text="均衡次数" FontWeight="Bold" Margin="0,0,0,2"/>

                                    <!-- Cell 1 -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Cell1:" Margin="0,2,5,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SignalValues[SuperCapController_Cap_Cell1Vol]}" x:Name="Cell1Voltage" Margin="0,2,5,0"/>
                                    <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="0,2,5,0">
                                        <Ellipse Width="8" Height="8" Fill="{Binding SignalValues[SuperCapController_Cap_Cell1OverVoltageState], Converter={StaticResource BoolToBrushConverter}}" Margin="0,0,2,0" x:Name="Cell1OverVoltageEllipse"/>
                                        <TextBlock Text="{Binding SignalValues[SuperCapController_Cap_Cell1OverVoltageState], Converter={StaticResource BoolToStringConverter}}" x:Name="Cell1OverVoltageStatus" Foreground="{Binding SignalValues[SuperCapController_Cap_Cell1OverVoltageState], Converter={StaticResource BoolToBrushConverter}}" FontSize="10"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" Margin="0,2,5,0">
                                        <Ellipse Width="8" Height="8" Fill="{Binding SignalValues[SuperCapController_Cap_Cell1ShortCircuitState], Converter={StaticResource BoolToBrushConverter}}" Margin="0,0,2,0" x:Name="Cell1ShortCircuitEllipse"/>
                                        <TextBlock Text="{Binding SignalValues[SuperCapController_Cap_Cell1ShortCircuitState], Converter={StaticResource BoolToStringConverter}}" x:Name="Cell1ShortCircuitStatus" Foreground="{Binding SignalValues[SuperCapController_Cap_Cell1ShortCircuitState], Converter={StaticResource BoolToBrushConverter}}" FontSize="10"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="4" Orientation="Horizontal" Margin="0,2,5,0">
                                        <Ellipse Width="8" Height="8" Fill="{Binding SignalValues[SuperCapController_Cap_Cell1BlanceState], Converter={StaticResource BoolToBrushConverter}}" Margin="0,0,2,0" x:Name="Cell1BalanceEllipse"/>
                                        <TextBlock Text="{Binding SignalValues[SuperCapController_Cap_Cell1BlanceState], Converter={StaticResource BoolToStringConverter}, ConverterParameter=balance}" x:Name="Cell1BalanceStatus" Foreground="{Binding SignalValues[SuperCapController_Cap_Cell1BlanceState], Converter={StaticResource BoolToBrushConverter}}" FontSize="10"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Grid.Column="5" Text="{Binding SignalValues[SuperCapController_Cap_Cell1BlanceCount]}" x:Name="Cell1BalanceCount" Margin="0,2,0,0" FontSize="10"/>

                                    <!-- Cell 2 -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Cell2:" Margin="0,2,5,0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SignalValues[SuperCapController_Cap_Cell2Vol]}" x:Name="Cell2Voltage" Margin="0,2,5,0"/>
                                    <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Margin="0,2,5,0">
                                        <Ellipse Width="8" Height="8" Fill="{Binding SignalValues[SuperCapController_Cap_Cell2OverVoltageState], Converter={StaticResource BoolToBrushConverter}}" Margin="0,0,2,0" x:Name="Cell2OverVoltageEllipse"/>
                                        <TextBlock Text="{Binding SignalValues[SuperCapController_Cap_Cell2OverVoltageState], Converter={StaticResource BoolToStringConverter}}" x:Name="Cell2OverVoltageStatus" Foreground="{Binding SignalValues[SuperCapController_Cap_Cell2OverVoltageState], Converter={StaticResource BoolToBrushConverter}}" FontSize="10"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal" Margin="0,2,5,0">
                                        <Ellipse Width="8" Height="8" Fill="{Binding SignalValues[SuperCapController_Cap_Cell2ShortCircuitState], Converter={StaticResource BoolToBrushConverter}}" Margin="0,0,2,0" x:Name="Cell2ShortCircuitEllipse"/>
                                        <TextBlock Text="{Binding SignalValues[SuperCapController_Cap_Cell2ShortCircuitState], Converter={StaticResource BoolToStringConverter}}" x:Name="Cell2ShortCircuitStatus" Foreground="{Binding SignalValues[SuperCapController_Cap_Cell2ShortCircuitState], Converter={StaticResource BoolToBrushConverter}}" FontSize="10"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="4" Orientation="Horizontal" Margin="0,2,5,0">
                                        <Ellipse Width="8" Height="8" Fill="{Binding SignalValues[SuperCapController_Cap_Cell2BlanceState], Converter={StaticResource BoolToBrushConverter}}" Margin="0,0,2,0" x:Name="Cell2BalanceEllipse"/>
                                        <TextBlock Text="{Binding SignalValues[SuperCapController_Cap_Cell2BlanceState], Converter={StaticResource BoolToStringConverter}, ConverterParameter=balance}" x:Name="Cell2BalanceStatus" Foreground="{Binding SignalValues[SuperCapController_Cap_Cell2BlanceState], Converter={StaticResource BoolToBrushConverter}}" FontSize="10"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="2" Grid.Column="5" Text="{Binding SignalValues[SuperCapController_Cap_Cell2BlanceCount]}" x:Name="Cell2BalanceCount" Margin="0,2,0,0" FontSize="10"/>

                                    <!-- Cell 3 -->
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Cell3:" Margin="0,2,5,0"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SignalValues[SuperCapController_Cap_Cell3Vol]}" x:Name="Cell3Voltage" Margin="0,2,5,0"/>
                                    <StackPanel Grid.Row="3" Grid.Column="2" Orientation="Horizontal" Margin="0,2,5,0">
                                        <Ellipse Width="8" Height="8" Fill="{Binding SignalValues[SuperCapController_Cap_Cell3OverVoltageState], Converter={StaticResource BoolToBrushConverter}}" Margin="0,0,2,0" x:Name="Cell3OverVoltageEllipse"/>
                                        <TextBlock Text="{Binding SignalValues[SuperCapController_Cap_Cell3OverVoltageState], Converter={StaticResource BoolToStringConverter}}" x:Name="Cell3OverVoltageStatus" Foreground="{Binding SignalValues[SuperCapController_Cap_Cell3OverVoltageState], Converter={StaticResource BoolToBrushConverter}}" FontSize="10"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="3" Grid.Column="3" Orientation="Horizontal" Margin="0,2,5,0">
                                        <Ellipse Width="8" Height="8" Fill="{Binding SignalValues[SuperCapController_Cap_Cell3ShortCircuitState], Converter={StaticResource BoolToBrushConverter}}" Margin="0,0,2,0" x:Name="Cell3ShortCircuitEllipse"/>
                                        <TextBlock Text="{Binding SignalValues[SuperCapController_Cap_Cell3ShortCircuitState], Converter={StaticResource BoolToStringConverter}}" x:Name="Cell3ShortCircuitStatus" Foreground="{Binding SignalValues[SuperCapController_Cap_Cell3ShortCircuitState], Converter={StaticResource BoolToBrushConverter}}" FontSize="10"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="3" Grid.Column="4" Orientation="Horizontal" Margin="0,2,5,0">
                                        <Ellipse Width="8" Height="8" Fill="{Binding SignalValues[SuperCapController_Cap_Cell3BlanceState], Converter={StaticResource BoolToBrushConverter}}" Margin="0,0,2,0" x:Name="Cell3BalanceEllipse"/>
                                        <TextBlock Text="{Binding SignalValues[SuperCapController_Cap_Cell3BlanceState], Converter={StaticResource BoolToStringConverter}, ConverterParameter=balance}" x:Name="Cell3BalanceStatus" Foreground="{Binding SignalValues[SuperCapController_Cap_Cell3BlanceState], Converter={StaticResource BoolToBrushConverter}}" FontSize="10"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="3" Grid.Column="5" Text="{Binding SignalValues[SuperCapController_Cap_Cell3BlanceCount]}" x:Name="Cell3BalanceCount" Margin="0,2,0,0" FontSize="10"/>

                                    <!-- Cell 4 -->
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Cell4:" Margin="0,2,5,0"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SignalValues[SuperCapController_Cap_Cell4Vol]}" x:Name="Cell4Voltage" Margin="0,2,5,0"/>
                                    <StackPanel Grid.Row="4" Grid.Column="2" Orientation="Horizontal" Margin="0,2,5,0">
                                        <Ellipse Width="8" Height="8" Fill="{Binding SignalValues[SuperCapController_Cap_Cell4OverVoltageState], Converter={StaticResource BoolToBrushConverter}}" Margin="0,0,2,0" x:Name="Cell4OverVoltageEllipse"/>
                                        <TextBlock Text="{Binding SignalValues[SuperCapController_Cap_Cell4OverVoltageState], Converter={StaticResource BoolToStringConverter}}" x:Name="Cell4OverVoltageStatus" Foreground="{Binding SignalValues[SuperCapController_Cap_Cell4OverVoltageState], Converter={StaticResource BoolToBrushConverter}}" FontSize="10"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="4" Grid.Column="3" Orientation="Horizontal" Margin="0,2,5,0">
                                        <Ellipse Width="8" Height="8" Fill="{Binding SignalValues[SuperCapController_Cap_Cell4ShortCircuitState], Converter={StaticResource BoolToBrushConverter}}" Margin="0,0,2,0" x:Name="Cell4ShortCircuitEllipse"/>
                                        <TextBlock Text="{Binding SignalValues[SuperCapController_Cap_Cell4ShortCircuitState], Converter={StaticResource BoolToStringConverter}}" x:Name="Cell4ShortCircuitStatus" Foreground="{Binding SignalValues[SuperCapController_Cap_Cell4ShortCircuitState], Converter={StaticResource BoolToBrushConverter}}" FontSize="10"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="4" Grid.Column="4" Orientation="Horizontal" Margin="0,2,5,0">
                                        <Ellipse Width="8" Height="8" Fill="{Binding SignalValues[SuperCapController_Cap_Cell4BlanceState], Converter={StaticResource BoolToBrushConverter}}" Margin="0,0,2,0" x:Name="Cell4BalanceEllipse"/>
                                        <TextBlock Text="{Binding SignalValues[SuperCapController_Cap_Cell4BlanceState], Converter={StaticResource BoolToStringConverter}, ConverterParameter=balance}" x:Name="Cell4BalanceStatus" Foreground="{Binding SignalValues[SuperCapController_Cap_Cell4BlanceState], Converter={StaticResource BoolToBrushConverter}}" FontSize="10"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="4" Grid.Column="5" Text="{Binding SignalValues[SuperCapController_Cap_Cell4BlanceCount]}" x:Name="Cell4BalanceCount" Margin="0,2,0,0" FontSize="10"/>

                                    <!-- Cell 5 -->
                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Cell5:" Margin="0,2,5,0"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SignalValues[SuperCapController_Cap_Cell5Vol]}" x:Name="Cell5Voltage" Margin="0,2,5,0"/>
                                    <StackPanel Grid.Row="5" Grid.Column="2" Orientation="Horizontal" Margin="0,2,5,0">
                                        <Ellipse Width="8" Height="8" Fill="{Binding SignalValues[SuperCapController_Cap_Cell5OverVoltageState], Converter={StaticResource BoolToBrushConverter}}" Margin="0,0,2,0" x:Name="Cell5OverVoltageEllipse"/>
                                        <TextBlock Text="{Binding SignalValues[SuperCapController_Cap_Cell5OverVoltageState], Converter={StaticResource BoolToStringConverter}}" x:Name="Cell5OverVoltageStatus" Foreground="{Binding SignalValues[SuperCapController_Cap_Cell5OverVoltageState], Converter={StaticResource BoolToBrushConverter}}" FontSize="10"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="5" Grid.Column="3" Orientation="Horizontal" Margin="0,2,5,0">
                                        <Ellipse Width="8" Height="8" Fill="{Binding SignalValues[SuperCapController_Cap_Cell5ShortCircuitState], Converter={StaticResource BoolToBrushConverter}}" Margin="0,0,2,0" x:Name="Cell5ShortCircuitEllipse"/>
                                        <TextBlock Text="{Binding SignalValues[SuperCapController_Cap_Cell5ShortCircuitState], Converter={StaticResource BoolToStringConverter}}" x:Name="Cell5ShortCircuitStatus" Foreground="{Binding SignalValues[SuperCapController_Cap_Cell5ShortCircuitState], Converter={StaticResource BoolToBrushConverter}}" FontSize="10"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="5" Grid.Column="4" Orientation="Horizontal" Margin="0,2,5,0">
                                        <Ellipse Width="8" Height="8" Fill="{Binding SignalValues[SuperCapController_Cap_Cell5BlanceState], Converter={StaticResource BoolToBrushConverter}}" Margin="0,0,2,0" x:Name="Cell5BalanceEllipse"/>
                                        <TextBlock Text="{Binding SignalValues[SuperCapController_Cap_Cell5BlanceState], Converter={StaticResource BoolToStringConverter}, ConverterParameter=balance}" x:Name="Cell5BalanceStatus" Foreground="{Binding SignalValues[SuperCapController_Cap_Cell5BlanceState], Converter={StaticResource BoolToBrushConverter}}" FontSize="10"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="5" Grid.Column="5" Text="{Binding SignalValues[SuperCapController_Cap_Cell5BlanceCount]}" x:Name="Cell5BalanceCount" Margin="0,2,0,0" FontSize="10"/>
                                </Grid>

                                <!-- 电容模组综合监控 -->
                                <TextBlock Text="电容模组综合监控" FontSize="12" FontWeight="Bold" Margin="0,0,0,3"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="模组电量:"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SignalValues[SuperCapController_Cap_ModulePower], StringFormat={}{0}%}" x:Name="ModuleSOC"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="模组电压:"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SignalValues[SuperCapController_Cap_ModuleVoltage], StringFormat={}{0}mV}" x:Name="ModuleVoltage"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="模组电流:"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SignalValues[SuperCapController_Cap_ModuleCurrent], StringFormat={}{0}mA}" x:Name="ModuleCurrent"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="放电平均电流:"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SignalValues[SuperCapController_Cap_DisChargeCurrent], StringFormat={}{0}mA}" x:Name="ModuleDischargeAvgCurrent"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="充放电状态:"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SignalValues[SuperCapController_Cap_MochainStatus], Converter={StaticResource MochainStatusConverter}}" x:Name="ModuleStatus" Foreground="{Binding SignalValues[SuperCapController_Cap_MochainStatus], Converter={StaticResource MochainStatusBrushConverter}}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- SRS碰撞CAN信号监控 -->
                        <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="8">
                            <StackPanel>
                                <TextBlock Text="SRS碰撞CAN信号监控" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="碰撞信号:"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="无" x:Name="CrashSignal" Foreground="Gray"/>
                                  </Grid>

                                <TextBlock Text="模组告警监控" FontSize="14" FontWeight="Bold" Margin="0,5,0,5"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- 温度和过温状态 -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="温度:"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SignalValues[SuperCapController_Cap_ModuleTempreture], StringFormat={}{0}°C}" x:Name="Temperature"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="过温:"/>
                                    <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{Binding SignalValues[SuperCapController_Cap_OverTempretureState], Converter={StaticResource BoolToBrushConverter}}" Margin="0,0,3,0" x:Name="OverTempEllipse"/>
                                        <TextBlock Text="{Binding SignalValues[SuperCapController_Cap_OverTempretureState], Converter={StaticResource BoolToStringConverter}}" x:Name="OverTempStatus" Foreground="{Binding SignalValues[SuperCapController_Cap_OverTempretureState], Converter={StaticResource BoolToBrushConverter}}" FontSize="12"/>
                                    </StackPanel>

                                    <!-- 容值和容值状态 -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="容值:"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SignalValues[SuperCapController_Cap_ModuleCapacity], StringFormat={}{0:N1}F}" x:Name="ModuleCapacity"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="容值状态:"/>
                                    <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{Binding SignalValues[SuperCapController_Cap_ModuleCapacityState], Converter={StaticResource BoolToBrushConverter}}" Margin="0,0,3,0" x:Name="CapacityStatusEllipse"/>
                                        <TextBlock Text="{Binding SignalValues[SuperCapController_Cap_ModuleCapacityState], Converter={StaticResource BoolToStringConverter}}" x:Name="CapacityStatus" Foreground="{Binding SignalValues[SuperCapController_Cap_ModuleCapacityState], Converter={StaticResource BoolToBrushConverter}}" FontSize="12"/>
                                    </StackPanel>

                                    <!-- 内阻和内阻状态 -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="内阻:"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SignalValues[SuperCapController_Cap_InternalResistance], StringFormat={}{0}mΩ}" x:Name="InternalResistance"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="内阻状态:"/>
                                    <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{Binding SignalValues[SuperCapController_Cap_InternalResistanceStatus], Converter={StaticResource BoolToBrushConverter}}" Margin="0,0,3,0" x:Name="ResistanceStatusEllipse"/>
                                        <TextBlock Text="{Binding SignalValues[SuperCapController_Cap_InternalResistanceStatus], Converter={StaticResource BoolToStringConverter}}" x:Name="ResistanceStatus" Foreground="{Binding SignalValues[SuperCapController_Cap_InternalResistanceStatus], Converter={StaticResource BoolToBrushConverter}}" FontSize="12"/>
                                    </StackPanel>

                                    <!-- 断路状态 -->
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="断路状态:"/>
                                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{Binding SignalValues[SuperCapController_Cap_OpenCircuitFault], Converter={StaticResource BoolToBrushConverter}}" Margin="0,0,3,0" x:Name="ModuleOpenCircuitEllipse"/>
                                        <TextBlock Text="{Binding SignalValues[SuperCapController_Cap_OpenCircuitFault], Converter={StaticResource BoolToStringConverter}}" x:Name="ModuleOpenCircuitStatus" Foreground="{Binding SignalValues[SuperCapController_Cap_OpenCircuitFault], Converter={StaticResource BoolToBrushConverter}}" FontSize="12"/>
                                    </StackPanel>

                                    <!-- 不均衡故障 -->
                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="不均衡:"/>
                                    <StackPanel Grid.Row="3" Grid.Column="3" Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{Binding SignalValues[SuperCapController_Cap_ImbalanceFault], Converter={StaticResource BoolToBrushConverter}}" Margin="0,0,3,0" x:Name="ImbalanceEllipse"/>
                                        <TextBlock Text="{Binding SignalValues[SuperCapController_Cap_ImbalanceFault], Converter={StaticResource BoolToStringConverter}}" x:Name="ImbalanceStatus" Foreground="{Binding SignalValues[SuperCapController_Cap_ImbalanceFault], Converter={StaticResource BoolToBrushConverter}}" FontSize="12"/>
                                    </StackPanel>

                                    <!-- 充电和放电故障 -->
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="充电故障:"/>
                                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{Binding SignalValues[SuperCapController_Cap_ChargeFault], Converter={StaticResource BoolToBrushConverter}}" Margin="0,0,3,0" x:Name="ChargeFaultEllipse"/>
                                        <TextBlock Text="{Binding SignalValues[SuperCapController_Cap_ChargeFault], Converter={StaticResource BoolToStringConverter}}" x:Name="ChargeFaultStatus" Foreground="{Binding SignalValues[SuperCapController_Cap_ChargeFault], Converter={StaticResource BoolToBrushConverter}}" FontSize="12"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="4" Grid.Column="2" Text="放电故障:"/>
                                    <StackPanel Grid.Row="4" Grid.Column="3" Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{Binding SignalValues[SuperCapController_Cap_DisChargeFault], Converter={StaticResource BoolToBrushConverter}}" Margin="0,0,3,0" x:Name="DischargeFaultEllipse"/>
                                        <TextBlock Text="{Binding SignalValues[SuperCapController_Cap_DisChargeFault], Converter={StaticResource BoolToStringConverter}}" x:Name="DischargeFaultStatus" Foreground="{Binding SignalValues[SuperCapController_Cap_DisChargeFault], Converter={StaticResource BoolToBrushConverter}}" FontSize="12"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 唤醒源监控 -->
